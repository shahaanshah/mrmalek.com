# Local CMS Configuration
CMS_SESSION_SECRET=your_secure_session_secret_at_least_32_characters_long
CMS_ADMIN_EMAIL=admin@mrmalek.com
CMS_ADMIN_INITIAL_PASSWORD=your_initial_admin_password

# Database Options:
# 1. MySQL (Recommended for Coolify / production):
# DATABASE_URL=mysql://user:password@host:3306/dbname
# Or:
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=secret
# MYSQL_DATABASE=mrmalek

# 2. SQLite (Fallback when MySQL is not configured):
CMS_DB_PATH=./.data/cms.sqlite
